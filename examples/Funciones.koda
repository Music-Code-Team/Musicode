-- [ Declaración ] --
// Regla de Oro: MusiCode no permite variables globales implícitas dentro de las funciones.
// Las funciones son "Cajas Negras". Si necesitan un dato externo, DEBE pasarse como parámetro.
// Esto previene los "efectos secundarios" (Side Effects) que suelen romper los motores de audio.

Int volumenGlobal = 10;

// ERROR SEMÁNTICO: El compilador bloqueará esto porque 'volumenGlobal' no está en su scope.
Void reproducirError() {
	engine.print(volumenGlobal); 
}

// CORRECTO: Se inyecta la dependencia a través de los parámetros con Tipado Estricto.
Void reproducirCorrecto(Int volumen) {
	engine.print(volumen);
}
reproducirCorrecto(volumenGlobal);


-- [ Retorno de Valores ] --
// Las funciones matemáticas o de manipulación de audio deben declarar su tipo de retorno.

Int suma(Int num1, Int num2) {
	return(num1 + num2);
}