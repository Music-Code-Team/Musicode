------------------------------------------[ Tipos de Dato Primitivos ]------------------------------------------
// MusiCode utiliza un tipado fuerte y estricto. Las declaraciones deben indicar el tipo.

Int:
	// Representa números enteros. Útil para contadores de bucles, octavas y divisores.
	// Regla Léxica: Secuencia de dígitos del 0 al 9, puede ser negativo.
	Int compases = 4;
	Int octava = -1;

Float:
	// Representa números con punto decimal. Fundamental para cálculos acústicos finos (ej. Amplitud 0.0 a 1.0).
	// Regla Léxica: DEBE incluir un dígito antes del punto (0.5 es válido, .5 lanzará Error de Sintaxis).
	Float sustainLevel = 0.8;
	Float divisor = 2.5;

Bool:
	// Representa un valor de verdad. Útil para controlar ciclos de Live Looping o activar/desactivar efectos.
	// Regla Léxica: Estrictamente minúsculas ('true' o 'false').
	Bool isPlaying = true;
	Bool hasReverb = false;

String:
	// Cadena de texto. En MusiCode su uso principal no es imprimir mensajes, sino pasar rutas 
	// de archivos, nombres de instrumentos o configuraciones del motor.
	// Regla Léxica: Estrictamente encerrado en comillas dobles ("").
	String archivoExportacion = "mi_cancion.wav";
	String instrumento = "piano_koda";
	
Array:
	// Colección dinámica de múltiples tipos.
	// Regla Arquitectónica: Un Array es solo almacenamiento de datos. Para aplicarle 
	// acústica o reproducirlo, debe ser inyectado en el constructor de un Track.
	Array miPartitura = [notaDo, 300ms, notaRe];