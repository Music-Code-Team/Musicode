------------------------------------------[ Importación y Exportación (Módulos) ]------------------------------------------

-- [ IMPORTACIÓN ] --
// La función global 'import("ruta")' permite modularizar proyectos grandes o cargar assets externos.
// Es una función polimórfica: su comportamiento cambia dependiendo de la extensión del archivo.

// 1. Importación de Media (.wav, .mp3)
// El motor decodifica el archivo de audio real y lo convierte nativamente en un objeto de MusiCode.
Track pistaVoz = import("voces_coro.wav");
Wave sampleKick = import("bombo.mp3");


// 2. Importación de Scripts (.koda)
// El motor ejecuta el script de forma aislada y captura el valor del 'return' en el scope global.
// Esto permite crear librerías de acordes, partituras o configuraciones acústicas.

----------[ partituraCompleja.koda ]----------
// Este archivo actúa como una librería pasiva. No reproduce sonido, solo devuelve datos.
Array partitura = [
    wave(400hz),
    300ms,
    wave(200hz)
];

return(partitura); // Exporta el arreglo al archivo que lo llame


----------[ script1.koda ]----------
// Archivo principal (Main)
Array notasBase = import("partituraCompleja.koda");
Envelope modificador = import("envelopeImaginario.koda"); // Asumiendo que devuelve un objeto Envelope

// Construimos la pista usando los módulos importados y encadenamos el modificador
Track pista1 = Track.new(notasBase).setEnvelope(modificador);

engine.play(pista1);
return(pista1); // Un script principal también puede ser importado por un script aún más grande


-- [ EXPORTACIÓN DE AUDIO ] --
// Una vez que el audio fue procesado matemáticamente por el motor, 
// se puede renderizar y guardar en el disco duro usando el método .export().

pista1.export("mi_cancion_final.wav");