------------------------------------------[ Tipos de Dato de Dominio Específico ]------------------------------------------
// Estos tipos abstraen la física del sonido. A nivel de Lexer (Tokens), 
// no llevan espacios entre el número y su magnitud.

Time:
	// Representa duraciones, retardos (delays) y ritmos temporales.
	// Regla Léxica: Un número (Int o Float) seguido inmediatamente por un sufijo de tiempo ('ms', 's', 'm', 'h').
	// Nota del Motor: Por debajo, el compilador convertirá todo internamente a milisegundos para la matemática del Engine.
	
	Time ataque = 300ms;  // Milisegundos
	Time compas = 2s;     // Segundos
	Time espera = 0.5h;   // Horas (Útil para instalaciones artísticas o Live Looping largo)


Frequency:
	// Representa el tono acústico (Pitch).
	// Regla Léxica 1 (Científica): Un número seguido inmediatamente del sufijo 'hz'.
	// Regla Léxica 2 (Musical): Tokens literales predefinidos. NO son Strings (no llevan comillas).
	// El Lexer los reconoce como palabras reservadas (Ej. Do4, La4, A1, C3).
	
	Frequency tonoMatematico = 400hz;
	Frequency notaLatina = Do4;
	Frequency notaAnglosajona = A4; 


Volumen:
	// Representa la amplitud de la onda o ganancia del Track.
	// Regla Léxica: Puede recibir valores crudos (escalas lineales) o el sufijo 'db' (escala logarítmica).
	// Nota del Motor: Los floats crudos (ej. 0.8) representan un porcentaje de amplitud del 0.0 al 1.0. 
	// Los 'db' se traducen a fórmulas de ganancia acústica.
	
	Volumen gananciaLineal = 0.8;      // 80% del volumen máximo
	Volumen gananciaAbsoluta = 200;    // Multiplicador de amplitud (¡Cuidado, puede saturar el audio!)
	Volumen gananciaDecibelios = 20db; // Aumento logarítmico