Track pista2 = Track.new(frq:30hz, pattern:"X . . . X . . . X X", beat:30bpm, sync:"loop")
Track pista3 = Track.new(A4, "X . . . X . . . X X", 60bpm, "stretch")
Track pista3 = Track.new(La2, "X . . . X . . . X X", 20bpm, "stretch")

