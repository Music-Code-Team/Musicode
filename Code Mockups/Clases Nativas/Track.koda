-- [ Modificación de Operadores - TRACKS ] --
[WIP]

-- [ Sobrecarga de Operadores - TRACKS ] --
// Nota visual: 'A & B' significa que las ondas A y B suenan juntas (Acorde/Polifonía).

Conc:
    // 1. Secuencia simple (Una pista después de otra de forma horizontal)
    // Nota: Las lógicas "stretch" o "loop" no aplican aquí porque las pistas NO suenan al mismo tiempo. 
    // Simplemente se concatenan los arreglos.
    pista1(30bpm) .. pista2(60bpm) 
    // [10Hz, 20Hz] .. [30Hz, 40Hz] = [10Hz, 20Hz, 30Hz, 40Hz]
    // En remplazo de pista1..Wave(), se usará: pista1..[Wave(30hz)] 

Uncat (Extracción de patrones):
    // Usamos un método explícito para manipular el arreglo de la pista.
    // Busca exactamente el patrón de la pista2 dentro de la pista1 y lo elimina,
    // devolviendo un Track más corto.
    pista1.remove(pista2) 
    

Sum:
    // 1. Polifonía simple (Mismos BPM, mismo tamaño)
    pista1(30bpm) + pista2(30bpm) 
    // [10Hz, 20Hz] + [30Hz, 40Hz] = [10Hz & 30Hz, 20Hz & 40Hz]

    // 2. Colisión de BPM: Lógica "stretch" (El motor estira la pista 2 para que coincida en tamaño)
    pista1(30bpm) + pista2(60bpm, "stretch") 
    // [10Hz, 20Hz, 30Hz] + [40Hz, 50Hz] 
    // = [10Hz & 40Hz, 20Hz & ~45Hz, 30Hz & 50Hz] (Interpola la pista estirada)

    // 3. Colisión de BPM: Lógica "loop" (El motor repite la pista 2 para rellenar)
    pista1(30bpm) + pista2(60bpm, "loop") 
    // [10Hz, 20Hz, 30Hz] + [40Hz, 50Hz] 
    // = [10Hz & 40Hz, 20Hz & 50Hz, 30Hz & 40Hz] (El 40Hz vuelve a empezar)

    pista1(60bpm) + pista2(30bpm, "stretch") 
    // [10Hz, 20Hz] + [30Hz, 40Hz, 50Hz] 
    // = [10Hz & ~35Hz, 20Hz & ~45Hz] (Comprime la pista 2 para que quepa)

    pista1(60bpm) + pista2(30bpm, "loop") 
    // [10Hz, 20Hz] + [30Hz, 40Hz, 50Hz] 
    // = [10Hz & 30Hz, 20Hz & 40Hz] (La pista 2 se corta porque la pista 1 se acabó)


Resta:
    // Regla: Cancelación de Fase (Resta acústica de arreglos). 
    // Se invierte la polaridad de la pista 2 y se superpone. 
    // Al igual que la Suma (+), las pistas chocan en el tiempo, por lo que aplican las reglas de BPM.

    // 1. Cancelación simple (Mismos BPM, mismo tamaño)
    pista1(30bpm) - pista2(30bpm) 
    // [10Hz, 20Hz] - [30Hz, 40Hz] = [10Hz - 30Hz, 20Hz - 40Hz]

    // 2. Colisión de BPM: Lógica "stretch" (El motor estira la pista 2 antes de restarla)
    pista1(30bpm) - pista2(60bpm, "stretch") 
    // [10Hz, 20Hz, 30Hz] - [40Hz, 50Hz] 
    // = [10Hz - 40Hz, 20Hz - ~45Hz, 30Hz - 50Hz] (Resta la pista interpolada)

    // 3. Colisión de BPM: Lógica "loop" (El motor repite la pista 2 antes de restarla)
    pista1(30bpm) - pista2(60bpm, "loop") 
    // [10Hz, 20Hz, 30Hz] - [40Hz, 50Hz] 
    // = [10Hz - 40Hz, 20Hz - 50Hz, 30Hz - 40Hz] (El 40Hz se vuelve a restar)


Multiplicación:
    // Regla: Ring Modulation (Modulación de Anillo).
    // Multiplica los arreglos de audio para crear efectos armónicos complejos.
    // Al superponerse, aplican las mismas reglas de colisión temporal.

    // 1. Modulación simple (Mismos BPM, mismo tamaño)
    pista1(30bpm) * pista2(30bpm) 
    // [10Hz, 20Hz] * [30Hz, 40Hz] = [10Hz * 30Hz, 20Hz * 40Hz]

    // 2. Colisión de BPM: Lógica "stretch"
    pista1(30bpm) * pista2(60bpm, "stretch") 
    // [10Hz, 20Hz, 30Hz] * [40Hz, 50Hz] 
    // = [10Hz * 40Hz, 20Hz * ~45Hz, 30Hz * 50Hz]

    // 3. Colisión de BPM: Lógica "loop"
    pista1(30bpm) * pista2(60bpm, "loop") 
    // [10Hz, 20Hz, 30Hz] * [40Hz, 50Hz] 
    // = [10Hz * 40Hz, 20Hz * 50Hz, 30Hz * 40Hz]


Volumen:
    pista1 * 2    // Multiplica toda la amplitud x2 (Sube los decibeles de la pista completa)
    pista1 * 0.5  // Reduce el volumen de toda la pista a la mitad
