Wave notaA = wave(400hz, 20db, 0.3, "sin");
Wave notaB = wave(A1, 30db, 0.3, "saw");
Wave notaC = wave(Do4, 20db, 0.5, "sin");
Wave notaD = wave(A4, 20db, 0.3);  // Si no se especifica forma, se usa "sin" por defecto
/*
	"sin" = Onda Senoidal (Curva parabólica suave, sonido puro)
	"saw" = Onda Sierra   (Pendiente aguda y corte brusco, sonido metálico)
	"tri" = Onda Triángulo(Subida y bajada recta, sonido aflautado)
	"sqa" = Onda Cuadrada (Subidas y bajadas abruptas, sonido 8-bit/retro)
*/

-- [ Modificación de atributos - WAVES (Métodos Explícitos) ] --

	// Tiempo:
	notaA.setDuration(10s, "stretch"/"loop") // Sobrescribe la duración (estira o recorta la onda a 10s exactos)
	notaA.addDuration(2s, at:0.5s)  // Le suma 2s de silencio en la amrca se (útil para el Release del ADSR)
	notaA.cut(1s)          // Recorta 1 segundo del final de la onda (El equivalente a tu tiempo negativo)
	notaA.reverse()        // Invierte el arreglo para que suene al revés
	notaA.remove(1s) // Remueve el primer segundo de la onda

	// Frecuencia:
	notaA.setFrequency(40hz) 
	notaA.addFrequency(10hz) // Sube el tono (Pitch bend up)
	notaA.subFrequency(10hz) // Baja el tono. (Si el resultado es < 0, el compilador lanza un Error Semántico)


-- [ Sobrecarga de Operadores - WAVES ] --
// Nota visual: 'A & B' significa que las ondas A y B suenan juntas (Polifonía).

Conc:
	// Secuencia simple (Una onda detrás de otra)
	wave(400hz, 1s) .. wave(300hz, 1s) 
	// = wave(400hz -> 300hz, 2s) (Las ondas se concatenan de forma horizontal)

	wave(400hz, 1s) .. wave(400hz)


Sum:
	// Polifonía (Múltiples frecuencias sonando al mismo tiempo en un solo bloque)
	wave(400hz, 1s) + wave(300hz, 1s) 
	// = wave(400hz & 300hz, 1s) (Crea una onda compuesta/acorde)

Resta:
	// Cancelación de Fase (Resta acústica de frecuencias)
	// Útil para limpiar ruido o anular frecuencias específicas.
	wave(400hz, 1s) - wave(300hz, 1s) 

Multiplicación:
	// 1. Ring Modulation (Onda * Onda)
	// Modula las frecuencias entre sí creando armónicos metálicos o robóticos.
	wave(400hz, 1s) * wave(300hz, 1s) 

Volumen (Excepción de Tipado Mixto DSP):
	// 2. Modificación de Amplitud (Onda * Escalar)
	wave(500hz, 10db) * 2   // = wave(500hz, 20db) (Sube el volumen al doble)
	wave(500hz, 10db) * 0.5 // = wave(500hz, 5db)  (Baja el volumen a la mitad)

División:
	// wave / wave = PROHIBIDA. 
	// El Lexer/Parser debe lanzar un Error Semántico para evitar División por Cero en el motor.